<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="grt_system_architecture" name="End-to-End HTTP Delivery Architecture">
    <mxGraphModel dx="1574" dy="895" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1480" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane_server" parent="1" style="swimlane;startSize=32;horizontal=1;containerType=swimlane;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;rounded=1;arcSize=4;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Server-Side Encryption (grt_server.py)&lt;/b&gt;" vertex="1">
          <mxGeometry height="360" width="440" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="srv_1" parent="lane_server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;1. Source Image &amp;amp; Edge Padding&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Pad (W₀, H₀) to multiple of M×N grid → (W&amp;#39;, H&amp;#39;)&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="48" as="geometry" />
        </mxCell>
        <mxCell id="srv_2" parent="lane_server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;2. Key Gen &amp;amp; 4-Condition Validation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Generate valid secret tuple (a, b, c, d, r&lt;sub&gt;m&lt;/sub&gt;, r&lt;sub&gt;n&lt;/sub&gt;)&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="128" as="geometry" />
        </mxCell>
        <mxCell id="srv_3" parent="lane_server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;3. Forward GRT Tile Permutation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Shuffle M×N tiles &amp;amp; displace origin (0,0) → (r&lt;sub&gt;m&lt;/sub&gt;, r&lt;sub&gt;n&lt;/sub&gt;)&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="208" as="geometry" />
        </mxCell>
        <mxCell id="srv_4" parent="lane_server" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;4. Scrambled Ciphertext Asset (1.3–2.2 ms)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;PNG / WebP / JPEG | Low Compression Overhead&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="288" as="geometry" />
        </mxCell>
        <mxCell id="e_srv_1_2" edge="1" parent="lane_server" source="srv_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="srv_2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_srv_2_3" edge="1" parent="lane_server" source="srv_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="srv_3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_srv_3_4" edge="1" parent="lane_server" source="srv_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="srv_4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lane_network" parent="1" style="swimlane;startSize=32;horizontal=1;containerType=swimlane;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;rounded=1;arcSize=4;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;HTTP Split-Channel Network&lt;/b&gt;" vertex="1">
          <mxGeometry height="360" width="440" x="500" y="20" as="geometry" />
        </mxCell>
        <mxCell id="net_cdn" parent="lane_network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Public CDN &amp;amp; API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;&lt;i&gt;Standard HTTP web hosting; no custom plugins&lt;/i&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="48" as="geometry" />
        </mxCell>
        <mxCell id="net_split" parent="lane_network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Split-Channel Delivery&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Channel A (CDN):&lt;/b&gt; Scrambled image&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Channel&amp;nbsp;B (API):&lt;/b&gt; Secret keys&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="400" x="20" y="128" as="geometry" />
        </mxCell>
        <mxCell id="threat_box" parent="lane_network" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeDashed=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Threat Model: Direct Scrapers &amp;amp; Bots (curl / crawlers)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Bots fetching Channel A directly without executing client context receive only a &lt;b&gt;corrupted, unusable tile grid&lt;/b&gt;.&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="20" y="233" as="geometry" />
        </mxCell>
        <mxCell id="e_net_1_2" edge="1" parent="lane_network" source="net_cdn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="net_split" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_net_bot" edge="1" parent="lane_network" source="net_split" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;dashed=1;fontSize=10;" target="threat_box" value="Direct HTTP GET (Ch. A only)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lane_client" parent="1" style="swimlane;startSize=32;horizontal=1;containerType=swimlane;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;rounded=1;arcSize=4;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Client Browser Decryption (igrt_client.js)&lt;/b&gt;" vertex="1">
          <mxGeometry height="360" width="440" x="980" y="20" as="geometry" />
        </mxCell>
        <mxCell id="cli_1" parent="lane_client" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;1. Receive Scrambled Image &amp;amp; Keys&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Load image from Ch. A and key tuple from Ch. B&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="48" as="geometry" />
        </mxCell>
        <mxCell id="cli_2" parent="lane_client" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;2. Precompute 4-Stage IGRT Lookup Tables&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Build 1D Int32Array LUTs in O(M + N) time&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="128" as="geometry" />
        </mxCell>
        <mxCell id="cli_3" parent="lane_client" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;3. 32-Bit Tile Reassembly &amp;amp; Edge Trim&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Copy pixels via Uint32Array &amp;amp; crop to (W₀, H₀)&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="208" as="geometry" />
        </mxCell>
        <mxCell id="cli_4" parent="lane_client" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;arcSize=8;align=center;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;4. Lossless HTML5 Canvas Render (0.3–0.5 ms)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;100% Bit-Exact Recovery (MSE = 0.0)&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="20" y="288" as="geometry" />
        </mxCell>
        <mxCell id="e_cli_1_2" edge="1" parent="lane_client" source="cli_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="cli_2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cli_2_3" edge="1" parent="lane_client" source="cli_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="cli_3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cli_3_4" edge="1" parent="lane_client" source="cli_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="cli_4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_srv_to_net" edge="1" parent="1" source="srv_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="net_cdn" value="Publish">
