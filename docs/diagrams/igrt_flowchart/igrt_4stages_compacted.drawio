<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="igrt_4stages_flowchart" name="4-Stage Inverse GRT Flowchart">
    <mxGraphModel dx="1100" dy="625" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="input_block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#0F172A;align=center;arcSize=6;spacing=8;" value="&lt;b style=&quot;font-size: 13px; color: #0F172A;&quot;&gt;Ciphertext Input&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;&lt;div style=&quot;font-size: 11px; color: #334155; text-align: left;&quot;&gt;• &lt;b&gt;Scrambled Tile:&lt;/b&gt; (x&amp;#39;, y&amp;#39;)&lt;br&gt;• &lt;b&gt;Grid Size:&lt;/b&gt; M × N&lt;br&gt;• &lt;b&gt;Factors:&lt;/b&gt; p, h, v&lt;br&gt;• &lt;b&gt;Keys:&lt;/b&gt; (a, b, c, d)&lt;br&gt;• &lt;b&gt;Offsets:&lt;/b&gt; (r&lt;sub&gt;m&lt;/sub&gt;, r&lt;sub&gt;n&lt;/sub&gt;)&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="210" y="105" as="geometry" />
        </mxCell>
        <mxCell id="stage1_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;align=center;arcSize=6;spacing=8;" value="&lt;b style=&quot;font-size: 13px; color: rgb(30, 58, 138);&quot;&gt;Stage 1: Equilateral Mapping&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#BFDBFE&quot;&gt;&lt;div style=&quot;font-size: 11px; color: rgb(51, 65, 85); text-align: left;&quot;&gt;&lt;b&gt;Input:&lt;/b&gt; (x&#39;, y&#39;) &amp;amp; (r&lt;sub&gt;m&lt;/sub&gt;, r&lt;sub&gt;n&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Remove translation offset &amp;amp; invert matrix modulo shared square factor &lt;i&gt;p&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: rgb(29, 78, 216);&quot;&gt;Output:&lt;/b&gt; Base Remainders &lt;b&gt;(x&lt;sub&gt;p&lt;/sub&gt;, y&lt;sub&gt;p&lt;/sub&gt;)&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="380" y="105" as="geometry" />
        </mxCell>
        <mxCell id="stage2_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;arcSize=6;spacing=8;" value="&lt;b style=&quot;font-size: 13px; color: rgb(146, 64, 14);&quot;&gt;Stage 2: Projection Mapping&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#FDE68A&quot;&gt;&lt;div style=&quot;font-size: 11px; color: rgb(51, 65, 85); text-align: left;&quot;&gt;&lt;b&gt;Input:&lt;/b&gt;&amp;nbsp;(x&#39;, y&#39;) &amp;amp; (x&lt;sub&gt;p&lt;/sub&gt;, y&lt;sub&gt;p&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Subtract remainder contribution &amp;amp; scale down by &lt;i&gt;p&lt;/i&gt; into aspect space (&lt;i&gt;h&lt;/i&gt; × &lt;i&gt;v&lt;/i&gt;).&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: rgb(180, 83, 9);&quot;&gt;Output:&lt;/b&gt; Projected Coords &lt;b&gt;(H, V)&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="550" y="105" as="geometry" />
        </mxCell>
        <mxCell id="stage3_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#6B21A8;align=center;arcSize=6;spacing=8;" value="&lt;b style=&quot;font-size: 13px; color: #6B21A8;&quot;&gt;Stage 3: Triangular Mapping&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#DDD6FE&quot;&gt;&lt;div style=&quot;font-size: 11px; color: #334155; text-align: left;&quot;&gt;&lt;b&gt;Input:&lt;/b&gt; Projected (H, V)&lt;br&gt;&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Apply axis-decoupling rule (Condition 1) &amp;amp; modular inverses modulo &lt;i&gt;h&lt;/i&gt; and &lt;i&gt;v&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #6D28D9;&quot;&gt;Output:&lt;/b&gt; Aspect Quotients &lt;b&gt;(x&lt;sub&gt;h&lt;/sub&gt;, y&lt;sub&gt;v&lt;/sub&gt;)&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="720" y="105" as="geometry" />
        </mxCell>
        <mxCell id="stage4_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;align=center;arcSize=6;spacing=8;" value="&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: rgb(6, 95, 70); font-size: 13px;&quot;&gt;Stage 4: Coordinate Assembly&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#A7F3D0&quot;&gt;&lt;div style=&quot;font-size: 11px; color: rgb(51, 65, 85); text-align: left;&quot;&gt;&lt;b&gt;Input:&lt;/b&gt; (x&lt;sub&gt;p&lt;/sub&gt;, y&lt;sub&gt;p&lt;/sub&gt;) &amp;amp; (x&lt;sub&gt;h&lt;/sub&gt;, y&lt;sub&gt;v&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Combine remainders &amp;amp; quotients:&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;x = x&lt;sub&gt;p&lt;/sub&gt; + p·x&lt;sub&gt;h&lt;/sub&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: rgb(51, 65, 85); text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;y = y&lt;sub&gt;p&lt;/sub&gt; + p·y&lt;sub&gt;v&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: rgb(4, 120, 87);&quot;&gt;Output:&lt;/b&gt; Original &lt;b&gt;(x, y)&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="140" x="890" y="105" as="geometry" />
        </mxCell>
        <mxCell id="bottom_badge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontColor=#0F172A;align=center;arcSize=6;spacing=4;" value="&lt;b style=&quot;font-size: 12px; color: #0F172A;&quot;&gt;Single-Pass O(1) Coordinate Recovery per Tile&lt;/b&gt; — Precomputed into 1D Lookup Tables (&lt;i&gt;igrt_client.js&lt;/i&gt;) for &lt;b&gt;0.32–0.51 ms&lt;/b&gt; Canvas rendering." vertex="1">
          <mxGeometry height="36" width="820" x="210" y="335" as="geometry" />
        </mxCell>
        <mxCell id="e_in_s1" edge="1" parent="1" source="input_block" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage1_card" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;">
          <mxGeometry relative="1" x="1" y="168" as="geometry">
            <mxPoint x="30" y="3" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_s1_s2" edge="1" parent="1" source="stage1_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#1E3A8A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage2_card" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;">
          <mxGeometry relative="1" x="0.3333" y="15" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_s2_s3" edge="1" parent="1" source="stage2_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage3_card" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;">
          <mxGeometry relative="1" y="-15" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_s3_s4" edge="1" parent="1" source="stage3_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#6B21A8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage4_card" value="">
          <mxGeometry relative="1" x="-0.3333" y="20" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_bypass_xp" edge="1" parent="1" source="stage1_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;fontSize=11;fontColor=#065F46;labelBackgroundColor=#ECFDF5;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="stage4_card" value="Feed Base Remainders (x_p, y_p)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="530" y="70" />
              <mxPoint x="1310" y="70" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
