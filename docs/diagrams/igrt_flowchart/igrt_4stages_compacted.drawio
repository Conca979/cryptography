<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="igrt_4stages_flowchart" name="4-Stage Inverse GRT Flowchart">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="800" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="input_block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;align=center;arcSize=6;spacing=6;" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;Ciphertext &amp;amp; Key&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12.5px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;• &lt;b&gt;Ciphertext:&lt;/b&gt; (x, y)&lt;sub&gt;n+1&lt;/sub&gt;&lt;br&gt;• &lt;b&gt;Domain:&lt;/b&gt; ℤ&lt;sub&gt;M&lt;/sub&gt; × ℤ&lt;sub&gt;N&lt;/sub&gt;&lt;br&gt;• &lt;b&gt;Factors:&lt;/b&gt; p, h, v&lt;br&gt;• &lt;b&gt;Matrix:&lt;/b&gt; G = (a, b, c, d)&lt;br&gt;• &lt;b&gt;Shift Key:&lt;/b&gt; (r&lt;sub&gt;m&lt;/sub&gt;, r&lt;sub&gt;n&lt;/sub&gt;)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="130" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stage1_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;align=center;arcSize=6;spacing=6;" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;Stage 1: Equilateral&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12.5px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;&lt;b&gt;In:&lt;/b&gt; (x, y)&lt;sub&gt;n+1&lt;/sub&gt;, (r&lt;sub&gt;m&lt;/sub&gt;, r&lt;sub&gt;n&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Map:&lt;/b&gt; Invert affine shift &amp;amp; matrix G over equilateral ring ℤ&lt;sub&gt;p&lt;/sub&gt; (Cond. 2).&lt;br&gt;&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; Residues &lt;b&gt;(x&lt;sub&gt;p&lt;/sub&gt;, y&lt;sub&gt;p&lt;/sub&gt;)&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="130" x="170" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stage2_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;align=center;arcSize=6;spacing=6;" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;Stage 2: Projection&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12.5px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;&lt;b&gt;In:&lt;/b&gt; (x, y)&lt;sub&gt;n+1&lt;/sub&gt;, (x&lt;sub&gt;p&lt;/sub&gt;, y&lt;sub&gt;p&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Map:&lt;/b&gt; Cancel ℤ&lt;sub&gt;p&lt;/sub&gt; residue contribution &amp;amp; project onto quotient ring&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;&lt;span&gt;ℤ&lt;/span&gt;&lt;sub&gt;h&lt;/sub&gt;&lt;span&gt; × ℤ&lt;/span&gt;&lt;sub&gt;v&lt;/sub&gt;&lt;span&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; Projected &lt;b&gt;(H, V)&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="130" x="320" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stage3_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;align=center;arcSize=6;spacing=6;" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;Stage 3: Triangular&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12.5px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;&lt;b&gt;In:&lt;/b&gt; Projected (H, V)&lt;br&gt;&lt;br&gt;&lt;b&gt;Map:&lt;/b&gt; Decouple cross-axis wrap (Cond. 1) &amp;amp; invert over ℤ&lt;sub&gt;h&lt;/sub&gt;, ℤ&lt;sub&gt;v&lt;/sub&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;&lt;span&gt;(Cond. 3–4).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; Quotients &lt;b&gt;(x&lt;sub&gt;h&lt;/sub&gt;, y&lt;sub&gt;v&lt;/sub&gt;)&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="130" x="470" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stage4_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;align=center;arcSize=6;spacing=6;" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;Stage 4: Synthesis&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12.5px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;font-size: 10.5px; text-align: left;&quot;&gt;&lt;b&gt;In:&lt;/b&gt; (x&lt;sub&gt;p&lt;/sub&gt;, y&lt;sub&gt;p&lt;/sub&gt;) &amp;amp; (x&lt;sub&gt;h&lt;/sub&gt;, y&lt;sub&gt;v&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Map:&lt;/b&gt; Mixed-radix reconstruction in:&lt;br&gt;&amp;nbsp; x = x&lt;sub&gt;p&lt;/sub&gt; + p·x&lt;sub&gt;h&lt;/sub&gt;&lt;br&gt;&amp;nbsp; y = y&lt;sub&gt;p&lt;/sub&gt; + p·y&lt;sub&gt;v&lt;/sub&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8.75px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 10.5px;&quot;&gt;Out:&lt;/b&gt;&lt;span style=&quot;font-size: 10.5px;&quot;&gt; Plaintext &lt;/span&gt;&lt;b style=&quot;font-size: 10.5px;&quot;&gt;(x, y)&lt;sub&gt;n&lt;/sub&gt;&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="130" x="620" y="60" as="geometry" />
        </mxCell>
        <mxCell id="e_in_s1" edge="1" parent="1" source="input_block" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage1_card" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s1_s2" edge="1" parent="1" source="stage1_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage2_card" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s2_s3" edge="1" parent="1" source="stage2_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage3_card" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s3_s4" edge="1" parent="1" source="stage3_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage4_card" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_bypass_xp" edge="1" parent="1" source="stage1_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;fontSize=10.5;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="stage4_card" value="Feed Base Residues (x_p, y_p) ∈ ℤ_p × ℤ_p">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="235" y="25" />
              <mxPoint x="685" y="25" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>