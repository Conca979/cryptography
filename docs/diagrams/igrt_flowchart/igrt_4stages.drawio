<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="igrt_4stages_flowchart" name="4-Stage Inverse GRT Flowchart">
    <mxGraphModel dx="1345" dy="938" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="input_block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#0F172A;align=center;arcSize=6;spacing=8;" value="&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(15, 23, 42), rgb(211, 218, 234)); font-size: 13px;&quot;&gt;Ciphertext Input&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(15, 23, 42), rgb(211, 218, 234)); font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(15, 23, 42), rgb(211, 218, 234)); font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 11px; color: rgb(51, 65, 85);&quot;&gt;&lt;b&gt;Scrambled Tile:&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px; color: rgb(51, 65, 85);&quot;&gt;(x&#39;, y&#39;)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(71, 85, 105);&quot;&gt;&lt;b&gt;Grid Factors:&lt;/b&gt;&lt;br&gt;p = gcd(M, N)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px; color: rgb(71, 85, 105);&quot;&gt;h = M / p,   v = N / p&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(71, 85, 105);&quot;&gt;&lt;b&gt;Secret Keys:&lt;/b&gt;&lt;br&gt;G = [[a, b], [c, d]]&lt;br&gt;Offsets: (r&lt;sub&gt;m&lt;/sub&gt;, r&lt;sub&gt;n&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(5, 150, 105);&quot;&gt;&lt;b&gt;Precomputed Inverses:&lt;/b&gt;&lt;br&gt;G&lt;sub&gt;[p]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; = (ad - bc)&lt;sup&gt;-1&lt;/sup&gt; mod p&lt;br&gt;a&lt;sub&gt;[h]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; = a&lt;sup&gt;-1&lt;/sup&gt; mod h&lt;br&gt;d&lt;sub&gt;[v]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; = d&lt;sup&gt;-1&lt;/sup&gt; mod v&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="140" x="110" y="140" as="geometry" />
        </mxCell>
        <mxCell id="stage1_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;align=center;arcSize=6;spacing=8;" value="&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: rgb(30, 58, 138); font-size: 14px;&quot;&gt;Stage 1: Equilateral Mapping&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: rgb(30, 58, 138); font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: rgb(30, 58, 138); font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 11px; color: rgb(37, 99, 235);&quot;&gt;&lt;b&gt;Find Remainder Modulo&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 12px; color: rgb(29, 78, 216);&quot;&gt;&lt;b&gt;x&lt;sub style=&quot;&quot;&gt;p&lt;/sub&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(37, 99, 235);&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;&lt;b&gt;and&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;color: light-dark(rgb(37, 99, 235), rgb(105, 158, 255)); font-size: 11px;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(29, 78, 216);&quot;&gt;&lt;b&gt;y&lt;sub style=&quot;&quot;&gt;p&lt;/sub&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(51, 65, 85);&quot;&gt;&lt;b&gt;1. Subtract Translation Offsets:&lt;/b&gt;&lt;br&gt;Δx = (x&#39; - r&lt;sub&gt;m&lt;/sub&gt;) mod M&lt;br&gt;Δy = (y&#39; - r&lt;sub&gt;n&lt;/sub&gt;) mod N&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Modular 2×2 Inversion mod p:&lt;/b&gt;&lt;br&gt;[ x&lt;sub&gt;p&lt;/sub&gt; ] = G&lt;sub&gt;[p]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; × [ d ,   (p - 1)b ] × [ Δx ] mod p&lt;br&gt;[ y&lt;sub&gt;p&lt;/sub&gt; ] = G&lt;sub&gt;[p]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; × [ (p - 1)c ,   a ] ×&amp;nbsp;[ Δy ] mod p&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Output Remainder Vector:&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px; color: rgb(29, 78, 216);&quot;&gt;x&lt;sub&gt;p&lt;/sub&gt; = x mod p&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px; color: rgb(29, 78, 216);&quot;&gt;y&lt;sub&gt;p&lt;/sub&gt; = y mod p&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Solves the square modular factor shared between M and N.&lt;/i&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="440" width="210" x="290" y="140" as="geometry" />
        </mxCell>
        <mxCell id="stage2_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;align=center;arcSize=6;spacing=8;" value="&lt;b style=&quot;font-size: 14px; color: rgb(146, 64, 14);&quot;&gt;Stage 2: Projection Mapping&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 11px; color: rgb(217, 119, 6);&quot;&gt;Project to Aspect Ratio Space H and V&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(51, 65, 85);&quot;&gt;&lt;b&gt;1. Forward Contribution of Remainder:&lt;/b&gt;&lt;br&gt;Δx&lt;sub&gt;p&lt;/sub&gt; = a × x&lt;sub&gt;p&lt;/sub&gt; + b × y&lt;sub&gt;p&lt;/sub&gt;&lt;br&gt;Δy&lt;sub&gt;p&lt;/sub&gt; = c × x&lt;sub&gt;p&lt;/sub&gt; + d × y&lt;sub&gt;p&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Integer Quotient Projection:&lt;/b&gt;&lt;br&gt;[ H ] = ⌊ 1/p × (Δx - Δx&lt;sub&gt;p&lt;/sub&gt;) ⌋ mod h&lt;br&gt;[ V ] = ⌊ 1/p × (Δy - Δy&lt;sub&gt;p&lt;/sub&gt;) ⌋ mod v&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Output Projected Coordinates:&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px; color: rgb(180, 83, 9);&quot;&gt;H ∈ ℤ&lt;sub&gt;h&lt;/sub&gt;   (0 ≤ H &amp;lt; h)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px; color: rgb(180, 83, 9);&quot;&gt;V ∈ ℤ&lt;sub&gt;v&lt;/sub&gt;   (0 ≤ V &amp;lt; v)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Eliminates remainder contribution, isolating rectangular quotient space.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="210" x="540" y="140" as="geometry" />
        </mxCell>
        <mxCell id="stage3_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#6B21A8;align=center;arcSize=6;spacing=8;" value="&lt;b style=&quot;font-size: 14px; color: rgb(107, 33, 168);&quot;&gt;Stage 3: Triangular Mapping&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 11px; color: rgb(124, 58, 237);&quot;&gt;Solve for Quotients (x&lt;sub&gt;h&lt;/sub&gt;, y&lt;sub&gt;v&lt;/sub&gt;) via Modular Inverses&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(51, 65, 85);&quot;&gt;&lt;b&gt;Triangular Decoupling (Condition 1):&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;• Case 1 (Diagonal: b%h == 0 and c%v == 0):&lt;/b&gt;&lt;br&gt;x&lt;sub&gt;h&lt;/sub&gt; = (a&lt;sub&gt;[h]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; × H) mod h&lt;br&gt;y&lt;sub&gt;v&lt;/sub&gt; = (d&lt;sub&gt;[v]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; × V) mod v&lt;br&gt;&lt;br&gt;&lt;b&gt;• Case 2 (Lower Triangular: b%h == 0, c%v ≠ 0):&lt;/b&gt;&lt;br&gt;x&lt;sub&gt;h&lt;/sub&gt; = (a&lt;sub&gt;[h]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; × H) mod h&lt;br&gt;y&lt;sub&gt;v&lt;/sub&gt; = d&lt;sub&gt;[v]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt;(V - c × x&lt;sub&gt;h&lt;/sub&gt;) mod v&lt;br&gt;&lt;br&gt;&lt;b&gt;• Case 3 (Upper Triangular: b%h ≠ 0, c%v == 0):&lt;/b&gt;&lt;br&gt;y&lt;sub&gt;v&lt;/sub&gt; = (d&lt;sub&gt;[v]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt; × V) mod v&lt;br&gt;x&lt;sub&gt;h&lt;/sub&gt; = a&lt;sub&gt;[h]&lt;/sub&gt;&lt;sup&gt;-1&lt;/sup&gt;(H - b × y&lt;sub&gt;v&lt;/sub&gt;) mod h&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px; color: rgb(107, 33, 168);&quot;&gt;Output: Quotients (x&lt;sub&gt;h&lt;/sub&gt;, y&lt;sub&gt;v&lt;/sub&gt;)&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="250" x="780" y="140" as="geometry" />
        </mxCell>
        <mxCell id="stage4_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;align=center;arcSize=6;spacing=8;" value="&lt;b style=&quot;font-size: 14px; color: rgb(6, 95, 70);&quot;&gt;Stage 4: Coordinate Assembly&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 11px; color: rgb(5, 150, 105);&quot;&gt;Synthesize Plaintext Coordinates (x, y)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(51, 65, 85);&quot;&gt;&lt;b&gt;1. Recombine Remainder &amp;amp; Quotient:&lt;/b&gt;&lt;br&gt;[ x ] = [ x&lt;sub&gt;p&lt;/sub&gt; ] + [ p × x&lt;sub&gt;h&lt;/sub&gt; ]&lt;br&gt;[ y ] = [ y&lt;sub&gt;p&lt;/sub&gt; ] + [ p × y&lt;sub&gt;v&lt;/sub&gt; ]&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Explicit Scalar Reconstruction:&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 13px; color: rgb(4, 120, 87);&quot;&gt;x = x&lt;sub&gt;p&lt;/sub&gt; + p × x&lt;sub&gt;h&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 13px; color: rgb(4, 120, 87);&quot;&gt;y = y&lt;sub&gt;p&lt;/sub&gt; + p × y&lt;sub&gt;v&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Output Properties:&lt;/b&gt;&lt;br&gt;• 0 ≤ x &amp;lt; M,   0 ≤ y &amp;lt; N&lt;br&gt;• Guaranteed 1-to-1 Bijection&lt;br&gt;• 100% Bit-Exact Reversal (diff = 0)&lt;br&gt;• Displaced Origin Fully Restored&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size: 13px; color: rgb(6, 78, 59); background-color: rgb(167, 243, 208); padding: 4px 8px; border-radius: 4px;&quot;&gt;Original Plaintext: (x, y)&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="220" x="1070" y="140" as="geometry" />
        </mxCell>
        <mxCell id="bottom_badge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontColor=#0F172A;align=center;arcSize=6;spacing=6;" value="&lt;b style=&quot;font-size: 13px; color: rgb(15, 23, 42);&quot;&gt;Computational Complexity: O(1) Analytical Closed-Form Per Tile (Zero Iterative Periodicity)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(71, 85, 105);&quot;&gt;&lt;br&gt;Each tile coordinate is resolved in O(1) array accesses, descrambling full images in &lt;b&gt;~0.3 – 0.5 ms&lt;/b&gt; on HTML5 Canvas.&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="1180" x="110" y="600" as="geometry" />
        </mxCell>
        <mxCell id="e_in_s1" edge="1" parent="1" source="input_block" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage1_card" value="Scrambled (x&#39;, y&#39;)">
          <mxGeometry relative="1" y="-20" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_s1_s2" edge="1" parent="1" source="stage1_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#1E3A8A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage2_card" value="(x_p, y_p)">
          <mxGeometry relative="1" y="-20" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_s2_s3" edge="1" parent="1" source="stage2_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage3_card" value="Projected (H, V)">
          <mxGeometry relative="1" x="0.3333" y="20" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_s3_s4" edge="1" parent="1" source="stage3_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#6B21A8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="stage4_card" value="Quotients (x_h, y_v)">
          <mxGeometry relative="1" y="20" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_bypass_xp" edge="1" parent="1" source="stage1_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2.5;dashed=1;fontSize=11;fontColor=#065F46;labelBackgroundColor=#ECFDF5;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="stage4_card" value="Remainder Feed: (x_p, y_p) passed directly to Stage 4 for CRT Recombination">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="105" />
              <mxPoint x="1415" y="105" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
